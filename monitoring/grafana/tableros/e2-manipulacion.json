                  "text": "DETENIDA",
                  "color": "red"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Criterio E2",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(e2_criterio_cumplido[1h])",
          "instant": true
