{
  "uid": "e2-manipulacion",
  "title": "E2 · Manipulación del libro",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "voltera",
    "e2"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodos en desacuerdo",
      "description": "Nodos cuyo hash difiere del de la mayoría. 0 = todos coinciden; 1 en el paso 3 = node4 detectado.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(e2_nodos_en_desacuerdo[1m])",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Detección (bloques) · meta ≤ 1",
      "description": "Bloques que pasaron entre la manipulación de node4 (paso 3) y su detección. Cumple si es 0 o 1.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(e2_deteccion_bloques[1h])",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-2": {
                  "text": "—",
                  "color": "text"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estado de la red",
      "description": "PRODUCIENDO si hubo un bloque nuevo en los últimos 8 s; DETENIDA si no. Con 2 de 4 caídos debe quedar DETENIDA.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(e2_red_detenida[1m])",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "PRODUCIENDO",
                  "color": "green"
                },
                "1": {
                  "text": "DETENIDA",
                  "color": "red"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Recuperación (s)",
      "description": "Segundos desde que vuelven node3 y node4 (paso 7) hasta que se confirma el primer lote pendiente.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(e2_recuperacion_s[1h])",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "No se recuperó",
                  "color": "red"
                },
                "-2": {
                  "text": "—",
                  "color": "text"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Criterio E2",
      "description": "Veredicto final del experimento: CUMPLE solo si se cumplen los cuatro escenarios del criterio de éxito.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(e2_criterio_cumplido[1h])",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Pendiente",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO CUMPLE",
                  "color": "red"
                },
                "1": {
                  "text": "CUMPLE",
                  "color": "green"
                },
                "-2": {
                  "text": "Pendiente",
                  "color": "text"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Paso del experimento",
      "description": "Qué paso corría en cada momento (e2_fase). Sirve de regla para leer los demás paneles.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "e2_fase",
          "legendFormat": "paso"
        }
      ],
      "options": {
        "showValue": "always",
        "mergeValues": true,
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Preparando",
                  "color": "text"
                },
                "1": {
                  "text": "1 Red sana",
                  "color": "green"
                },
                "2": {
                  "text": "2 Carga",
                  "color": "blue"
                },
                "3": {
                  "text": "3 node4 miente",
                  "color": "orange"
                },
                "4": {
                  "text": "4 node4 restaurado",
                  "color": "green"
                },
                "5": {
                  "text": "5 Cae node4",
                  "color": "yellow"
                },
                "6": {
                  "text": "6 Caen node4 y node3",
                  "color": "red"
                },
                "7": {
                  "text": "7 Recuperación",
                  "color": "purple"
                },
                "8": {
                  "text": "Terminado",
                  "color": "text"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        }
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Estado por nodo",
      "description": "Una franja por nodo: verde ok (coincide con la mayoría), naranja DIVERGE (hash distinto), rojo CAÍDO (no responde).",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "e2_nodo_estado",
          "legendFormat": "{{nodo}}"
        }
      ],
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ok",
                  "color": "green"
                },
                "1": {
                  "text": "DIVERGE",
                  "color": "orange"
                },
                "2": {
                  "text": "CAÍDO",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Altura por nodo",
      "description": "Último bloque de cada nodo. Con 1 de 4 caído sigue subiendo; con 2 de 4 se congela (sin quórum QBFT).",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ethereum_blockchain_height",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull"
          ],
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Facturas: confirmadas y pendientes",
      "description": "Confirmadas: facturas cuyo lote ya tiene recibo (acumulado). Pendientes: enviadas sin recibo. Sin quórum, confirmadas queda plana y pendientes crece; al recuperar, pendientes vuelve a 0.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "e2_facturas_confirmadas",
          "legendFormat": "confirmadas"
        },
        {
          "refId": "B",
          "expr": "e2_facturas_pendientes",
          "legendFormat": "pendientes"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull"
          ],
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pendientes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
