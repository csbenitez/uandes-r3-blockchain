      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Pendiente",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO CUMPLE",
                  "color": "red"
                },
                "1": {
                  "text": "CUMPLE",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Estado por nodo",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "e2_nodo_estado",
          "legendFormat": "{{nodo}}"
        }
      ],
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ok",
                  "color": "green"
                },
                "1": {
                  "text": "DIVERGE",
                  "color": "orange"
                },
                "2": {
                  "text": "CAÍDO",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Altura por nodo",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
