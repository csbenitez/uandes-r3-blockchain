{
  "uid": "e2-manipulacion",
  "title": "E2 · Manipulación del libro",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "2s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "tags": [
    "voltera",
    "e2"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fase",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(e2_fase[1h])",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin iniciar",
                  "color": "text"
                },
                "1": {
                  "text": "1 · Red sana",
                  "color": "green"
                },
                "2": {
                  "text": "2 · Carga encendida",
                  "color": "green"
                },
                "3": {
                  "text": "3 · node4 reescribe",
                  "color": "orange"
                },
                "4": {
                  "text": "4 · Restaurar node4",
                  "color": "green"
                },
                "5": {
                  "text": "5 · Cae 1 de 4",
                  "color": "orange"
                },
                "6": {
                  "text": "6 · Caen 2 de 4",
                  "color": "red"
                },
                "7": {
                  "text": "7 · Recuperación",
                  "color": "orange"
                },
                "8": {
                  "text": "Terminado",
                  "color": "blue"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodos activos (de 4)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"besu\"})",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          },
          "min": 0,
          "max": 4
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodos en desacuerdo",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 9,
        "y": 0
      },
      "datasource": {
